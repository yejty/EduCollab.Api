# Copy on the collab host:
#   cp .env.hetzner.example .env.hetzner
#   docker compose -p educollab-collab-v2 -f docker-compose.hetzner.yml --env-file .env.hetzner up -d --build
#
# MATCH values must equal the API host .env.hetzner (SessionJoin__SecretKey / InternalApi__ApiKey).

COLLAB_HOST_PORT=2568

# Frontend + API origins allowed to open WebSocket connections
COLLAB_ALLOWED_ORIGINS=https://skyform.space,https://api.example.com

# Public HTTPS URL of the EduCollab API (no trailing slash)
EDUCOLLAB_API_BASE=https://api.example.com

# MATCH API SessionJoin__SecretKey / Issuer / Audience
SESSION_JOIN_SECRET=replace-with-long-shared-session-join-secret
SESSION_JOIN_ISSUER=EduCollab.Api
SESSION_JOIN_AUDIENCE=EduCollab.CollabServer

# MATCH API InternalApi__ApiKey
EDUCOLLAB_INTERNAL_API_KEY=replace-with-long-shared-internal-api-key

COLLAB_LOG_LEVEL=info
COLLAB_MONITOR_USER=admin
COLLAB_MONITOR_PASSWORD=
