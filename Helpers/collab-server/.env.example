# --- educollab-collab-server (self-hosted Colyseus) ---

# HTTP/WebSocket port. The container exposes this; Caddy reverse-proxies onto it.
COLLAB_PORT=2567
COLLAB_BIND_ADDR=0.0.0.0

# CORS allowlist (comma-separated). Use "*" for dev only.
COLLAB_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# EduCollab API base (no trailing slash). Used for room-started/room-ended webhooks.
EDUCOLLAB_API_BASE=http://localhost:8080

# Must match EduCollab SessionJoin:SecretKey (HMAC secret for join tickets).
SESSION_JOIN_SECRET=replace-this-with-a-long-session-join-secret-key
SESSION_JOIN_ISSUER=EduCollab.Api
SESSION_JOIN_AUDIENCE=EduCollab.CollabServer

# Must match EduCollab InternalApi:ApiKey (X-Api-Key on webhooks).
EDUCOLLAB_INTERNAL_API_KEY=dev-internal-api-key-change-me

# Optional: lock down monitor dashboard (Colyseus's built-in /colyseus admin UI)
# with HTTP basic auth. Set password to "" to disable monitor entirely.
COLLAB_MONITOR_USER=admin
COLLAB_MONITOR_PASSWORD=

# Optional: log level — "debug" | "info" | "warn" | "error"
COLLAB_LOG_LEVEL=info
