# --- collab-server (self-hosted Colyseus) ---

# HTTP/WebSocket port. The container exposes this; Caddy reverse-proxies onto it.
COLLAB_PORT=2567
COLLAB_BIND_ADDR=0.0.0.0

# CORS allowlist (comma-separated). Use "*" for dev only.
COLLAB_ALLOWED_ORIGINS=https://alphacollab-admin.vercel.app,http://localhost:5173

# AlphaCollab API base — used to validate bearer tokens in production.
# Leave blank to skip remote validation (token is still decoded for identity).
COLLAB_ALPHACOLLAB_API_BASE=https://assetstore.alphacollab.online

# Path on the AlphaCollab API used for bearer-token validation.
# A 200/204 response means the token is valid.
# Most APIs expose /me; if yours uses a different cheap authenticated endpoint,
# set it here (e.g. /assets?limit=1).
COLLAB_VALIDATE_PATH=/me

# When 1, every request must pass remote validation against AlphaCollab.
# When 0 (default), bearer is decoded locally (signature NOT verified) and
# treated as authenticated if `exp` is in the future. Use 1 in production.
COLLAB_VALIDATE_VIA_API=0

# How long (in seconds) to cache successful token validations.
COLLAB_AUTH_CACHE_SECONDS=60

# SQLite database file. Mount this path as a docker volume to persist sessions.
COLLAB_DB_PATH=/var/collab-data/collab.sqlite

# Optional: lock down monitor dashboard (Colyseus's built-in /colyseus admin UI)
# with HTTP basic auth. Set to "" to disable monitor entirely.
COLLAB_MONITOR_USER=admin
COLLAB_MONITOR_PASSWORD=

# Optional: log level — "debug" | "info" | "warn" | "error"
COLLAB_LOG_LEVEL=info
