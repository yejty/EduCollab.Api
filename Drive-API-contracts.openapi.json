{
  "openapi": "3.0.1",
  "info": {
    "title": "Drive API contracts",
    "description": "Requests the Drive app makes to the Space API through DriveAPI. 9 November 2026.\n\nEvery call uses a Bearer app token except `POST /login` and `POST /login/2fa`.\n\nThis document transcribes `Drive-API-contracts.pdf`. The source names methods, paths, request fields, and response shapes. It does not name HTTP status codes, error bodies, or nullability. Success responses below use `200` when the source shows a body and `204` when it shows no body.\n\nTwo response fields are named but not typed in the source and are modeled here as follows:\n- `DriveListing.roots` items are `StorageNode`.\n- `GET /storage/nodes/{id}/children` returns `parent` as `StorageNode` and `children` as `StorageNode[]`.",
    "version": "2026-11-09"
  },
  "tags": [
    { "name": "Sign-in" },
    { "name": "Device token" },
    { "name": "Listing and nodes" },
    { "name": "Dispatch" }
  ],
  "paths": {
    "/login": {
      "post": {
        "tags": ["Sign-in"],
        "summary": "Sign in with user name and password.",
        "operationId": "login",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "LoginSuccess, or TwoFactorChallenge when a second factor is required. The source does not name an HTTP status.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    { "$ref": "#/components/schemas/LoginSuccess" },
                    { "$ref": "#/components/schemas/TwoFactorChallenge" }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/login/2fa": {
      "post": {
        "tags": ["Sign-in"],
        "summary": "Complete sign-in with a two-factor code.",
        "operationId": "loginTwoFactor",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginTwoFactorRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "LoginSuccess. The source does not name an HTTP status.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LoginSuccess" }
              }
            }
          }
        }
      }
    },
    "/me/apps/tokens": {
      "post": {
        "tags": ["Device token"],
        "summary": "Issue an app token.",
