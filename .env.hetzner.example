# Copy on the API Hetzner host:
#   cp .env.hetzner.example .env.hetzner
#   docker compose -f docker-compose.hetzner.yml --env-file .env.hetzner up -d --build
#
# Collab: Helpers/collab-server/docker-compose.hetzner.yml + .env.hetzner
# Values marked MATCH must be identical on the collab host .env.hetzner.

ASPNETCORE_ENVIRONMENT=Production

# --- Auth ---
Jwt__SecretKey=replace-with-long-random-jwt-secret

# --- Session join / collab (MATCH collab SESSION_JOIN_* / EDUCOLLAB_INTERNAL_API_KEY) ---
SessionJoin__SecretKey=replace-with-long-shared-session-join-secret
SessionJoin__Issuer=EduCollab.Api
SessionJoin__Audience=EduCollab.CollabServer
# Public WSS URL clients use to reach collab (proxy hostname preferred)
SessionJoin__ColyseusEndpoint=wss://collab.example.com
SessionJoin__FrontendGuestJoinUrl=https://skyform.space/sessions/join
InternalApi__ApiKey=replace-with-long-shared-internal-api-key

# --- Frontend / email ---
WorkspaceInvitation__FrontendAcceptUrl=https://skyform.space/workspace/join
EmailConfirmation__FrontendConfirmUrl=https://skyform.space/auth/confirm-email
Email__Enabled=true
Email__SmtpHost=
Email__SmtpPort=587
Email__UseSsl=true
Email__UserName=
Email__Password=
Email__FromAddress=noreply@skyform.space
Email__FromDisplayName=SkyForm

# Receives workspace creation request notification emails
PlatformAdmin__Email=admin@example.com
